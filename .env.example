# ================================================================
# Configuração do Apuração 2026 — copie pra .env e ajuste
# ================================================================

# Banco de dados — Railway injeta DATABASE_URL automaticamente no
# formato postgres:// e o app normaliza pra postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://apuracao:apuracao@postgres:5432/apuracao

# ---------------- Segurança ----------------
# Protege os endpoints /api/admin/*. GERE UM VALOR FORTE em produção
# (mínimo 32 chars). Se vazio, os endpoints admin ficam ABERTOS —
# usar só em dev local.
ADMIN_TOKEN=

# CORS origins comma-separated. Setar pra URL pública do Railway.
CORS_ORIGINS=http://localhost:8080

# Chave pra sessão futura (rotacionar em prod).
SESSION_SECRET=change-me-in-production

# ---------------- TSE ----------------
# Base das apurações ao vivo (resultados.tse.jus.br não tem Akamai —
# Railway acessa direto).
TSE_CDN_BASE=https://resultados.tse.jus.br/oficial/ele2026

# Códigos internos da eleição no TSE. O app tem descoberta automática
# (poller/descoberta.py roda a cada 5min); estes são só fallback.
ELEICAO_ANO=2026
ELEICAO_COD_1T=21270
ELEICAO_COD_2T=21271
# Código do sistema Divulgação de Candidaturas (candidatos + fotos)
ELEICAO_COD_DIVULGA=20322002026

# Base da API de candidatos + fotos (divulgacandcontas.tse.jus.br
# tem Akamai — Railway toma 403 direto). Ver docs/operations.md
# sobre coleta via Termux pra popular candidatos e fotos.
TSE_DIVULGA_BASE=https://divulgacandcontas.tse.jus.br/divulga/rest/v1/candidatura/listar
TSE_FOTOS_BASE=https://divulgacandcontas.tse.jus.br/divulga/rest/arquivo/img

# Intervalo do poller de apuração (segundos).
POLL_INTERVAL_SECONDS=20

# Proxy pra contornar Akamai (opcional). Rotação suportada:
# TSE_PROXY_LIST=http://ip1:porta,http://ip2:porta
TSE_PROXY=
TSE_PROXY_LIST=

# ---------------- Bot do Telegram ----------------
# Setar TELEGRAM_BOT_TOKEN habilita o bot (long polling no lifespan).
# Sem token, o bot fica desligado — sem erro.
# TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# TELEGRAM_BOT_USERNAME=avisoeleicao_bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=avisoeleicao_bot

# ---------------- Web Push (opcional) ----------------
# Gere um par com: python -m py_vapid --gen
# Vazio desabilita Web Push (bot Telegram cobre a mesma função).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@example.com
